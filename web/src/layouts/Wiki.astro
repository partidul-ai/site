---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

type Props = import('astro/types').ComponentProps<typeof Base> & { title: string };

const props = Astro.props;
---

<Base {...props}>
  <div class="flex min-h-dvh flex-col pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)]">
    <SiteHeader />

    <main class="mx-auto w-full max-w-[1440px] flex-1 px-4 py-8 sm:px-8 sm:py-12">
      <slot />
    </main>

    <footer class="mx-auto flex w-full max-w-[1440px] items-baseline justify-between gap-4 px-4 pb-3 font-mono text-[10px] text-dim sm:px-8 sm:pb-5 sm:text-[11px]">
      <span><span class="whitespace-nowrap">Nu suntem un partid politic.</span> <span class="whitespace-nowrap">Dar ne pasă.</span> <a href="/privacy" class="whitespace-nowrap underline underline-offset-4 decoration-line hover:text-fg">Confidențialitate</a></span>
      <a href="/" class="whitespace-nowrap underline underline-offset-4 decoration-acc-fg">Spune ce merge →</a>
    </footer>
  </div>
</Base>
