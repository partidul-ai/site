---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Quiz from '../components/Quiz';
---

<Base title="Chestionar — partidul.ai" noindex>
  <div class="flex min-h-dvh flex-col pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)]">
    <SiteHeader />
    <main class="mx-auto flex w-full max-w-[1440px] flex-1 flex-col px-4 py-6 sm:px-8 lg:py-8">
      <Quiz client:load />
    </main>
  </div>
</Base>
